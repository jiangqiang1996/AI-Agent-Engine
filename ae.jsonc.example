{
  "$schema": "https://gitee.com/jiangqiang1996/ai-agent-engine/raw/master/ae.schema.json",

  "ae-linux-remote-ops": {
    "host": "",
    "port": 22,
    "user": "",
    "passwordEnv": "SSH_PASSWORD",
    "sudoPasswordEnv": "",
    "keyFile": "",
    "hostFingerprint": "",
    "timeoutSec": 15,
    "execTimeoutSec": 300,
    "keepaliveIntervalSec": 10
  },

  "ae-pptx": {
    "imageModel": {
      "provider": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-image-1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "timeoutSec": 180
    }
  },

  "ae-qwen3-tts": {
    "modelRoot": "",
    "outputDir": "",
    "device": "auto",
    "dtype": "auto",
    "attnImpl": "auto"
  }
}
