{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Findings",
  "description": "统一审查子代理的结构化输出 schema（代码域和文档域通用）",
  "type": "object",
  "required": ["reviewer", "findings", "residual_risks"],
  "properties": {
    "reviewer": {
      "type": "string",
      "description": "产生此输出的人设名称（例如 'correctness-reviewer'、'coherence-reviewer'）"
    },
    "findings": {
      "type": "array",
      "description": "审查发现列表。未发现问题时为空数组。",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "domain",
          "location",
          "why_it_matters",
          "finding_type",
          "autofix_class",
          "confidence",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "简短、具体的问题标题，10个词以内。",
            "maxLength": 100
          },
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "问题严重程度级别"
          },
          "domain": {
            "type": "string",
            "enum": ["code", "document"],
            "description": "发现所属域"
          },
          "location": {
            "description": "发现位置，代码域为 file+line，文档域为 file+section",
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "file", "line"],
                "properties": {
                  "type": { "const": "code" },
                  "file": { "type": "string", "description": "相对于仓库根目录的文件路径" },
                  "line": { "type": "integer", "description": "问题的主要行号", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "required": ["type", "file", "section"],
                "properties": {
                  "type": { "const": "document" },
                  "file": { "type": "string", "description": "文档路径" },
                  "section": { "type": "string", "description": "文档中的章节标识" }
                }
              }
            ]
          },
          "why_it_matters": {
            "type": "string",
            "description": "影响和故障模式——不是'哪里错了'，而是'什么会出问题'"
          },
          "finding_type": {
            "type": "string",
            "enum": ["error", "omission", "pre-existing"],
            "description": "发现类型：error（有误之处）、omission（遗漏内容）、pre-existing（预存问题，与当前变更无关）"
          },
          "autofix_class": {
            "type": "string",
            "enum": ["auto", "gated", "manual", "advisory"],
            "description": "审查者对综合后该问题处理方式的保守建议"
          },
          "suggested_fix": {
            "type": ["string", "null"],
            "description": "具体的最小修复方案。auto 类发现必须提供，其余可选。"
          },
          "confidence": {
            "type": "number",
            "description": "审查者对此发现的置信度",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "evidence": {
            "type": "array",
            "description": "基于实际代码/内容的证据。至少1项。",
            "items": { "type": "string" },
            "minItems": 1
          },
          "owner": {
            "type": "string",
            "enum": ["review-fixer", "downstream-resolver", "human", "release"],
            "description": "综合后应负责该发现后续行动的角色（代码域必填语义）"
          },
          "requires_verification": {
            "type": "boolean",
            "description": "此发现的修复是否需要通过针对性测试或后续审查重新验证（代码域必填语义）"
          },
          "deferred_questions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "文档域：需要推迟到后续阶段回答的问题"
          }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "description": "审查者注意到但无法确认为发现的风险",
      "items": { "type": "string" }
    },
    "testing_gaps": {
      "type": "array",
      "description": "审查者识别到的缺失测试覆盖",
      "items": { "type": "string" }
    },
    "deferred_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "文档域：顶层推迟问题"
    }
  },
  "_meta": {
    "confidence_thresholds": {
      "code": {
        "suppress": "低于 0.60——不报告。例外：0.50+ 的 P0。",
        "flag": "0.60-0.69——仅在明确可操作时包含。",
        "confident": "0.70-0.84——附完整证据报告。",
        "certain": "0.85-1.00——仅从代码验证。"
      },
      "document": {
        "suppress": "低于 0.50——不报告。例外：0.50+ 的 P0。",
        "flag": "0.50-0.59——标记为残余风险。",
        "confident": "0.60-0.84——附完整证据报告。",
        "certain": "0.85-1.00——确定，报告。"
      }
    },
    "autofix_classes": {
      "auto": "可根据同一文件、同一计划/需求、项目既有规范、稳定模板或明确用户意图推断出唯一最小修复。判断标准不是"这个修复重要吗？"，而是"不引入新立场时是否只有一种合理改法？"",
      "gated": "修复方案明确但需要人类审批（代码域）或需要用户判断（文档域）",
      "manual": "需要设计决策或跨模块变更",
      "advisory": "建议性改进，不构成阻断"
    },
    "autofix_mapping": {
      "old_code_to_new": {
        "safe_auto": "auto",
        "gated_auto": "gated"
      },
      "old_document_to_new": {
        "auto": "auto",
        "present": "gated"
      }
    },
    "finding_type_mapping": {
      "code_pre_existing_true": "pre-existing",
      "document_original": ["error", "omission"]
    },
    "domain_specific_rules": {
      "code": "owner 和 requires_verification 为必填语义（schema 层可选，综合流水线校验）",
      "document": "deferred_questions 为顶层字段"
    },
    "return_tiers": {
      "merge_tier": "返回给编排器：title、severity、domain、location、finding_type、autofix_class、confidence、owner、requires_verification、pre_existing、suggested_fix。",
      "detail_tier": "产物文件中必填：why_it_matters、evidence。"
    }
  }
}
