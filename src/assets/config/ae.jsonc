{
  "$schema": "./ae.schema.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 5000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 5000
    }
  },
  "graph": {
    "exclude": [
      "ae/graphs",
      "**/dist",
      "**/node_modules"
    ]
  }
}
