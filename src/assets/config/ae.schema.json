{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "./ae.schema.json",
  "title": "AE Builtin Opencode Config",
  "description": "Builtin opencode config nodes provided by AE. Known nodes are validated, future top-level nodes are preserved by runtime merge logic.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/definitions/localMcp" },
          { "$ref": "#/definitions/remoteMcp" },
          { "$ref": "#/definitions/mcpOverlay" }
        ]
      }
    },
    "modelScenarios": {
      "type": "object",
      "description": "模型场景到 opencode 模型标识的极简映射。稳定场景包括 quick、standard、deep、vision；允许自定义场景键。",
      "properties": {
        "quick": {
          "type": "string",
          "minLength": 1,
          "description": "快速任务使用的模型标识"
        },
        "standard": {
          "type": "string",
          "minLength": 1,
          "description": "标准任务使用的模型标识"
        },
        "deep": {
          "type": "string",
          "minLength": 1,
          "description": "深度推理任务使用的模型标识"
        },
        "vision": {
          "type": "string",
          "minLength": 1,
          "description": "视觉任务使用的模型标识"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "examples": [
        {
          "quick": "provider/fast-model",
          "standard": "provider/default-model",
          "deep": "provider/strong-model",
          "vision": "provider/vision-model"
        }
      ]
    }
  },
  "definitions": {
    "localMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "type": {
          "const": "local"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "timeout": {
          "type": "number"
        }
      }
    },
    "remoteMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "type": {
          "const": "remote"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "enabled": {
          "type": "boolean"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "oauth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            },
            {
              "const": false
            }
          ]
        },
        "timeout": {
          "type": "number"
        }
      }
    },
    "mcpOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["local", "remote"]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "enabled": {
          "type": "boolean"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "oauth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            },
            {
              "const": false
            }
          ]
        },
        "timeout": {
          "type": "number"
        }
      }
    }
  }
}
