{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AE Skills 配置",
  "description": "AE 技能合集的配置文件。顶层 key 与技能同名，每个技能只读取自己的 key。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "ae-linux-remote-ops": {
      "type": "object",
      "description": "ae-linux-remote-ops 技能的 SSH 连接配置",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "服务器 IP 或域名"
        },
        "port": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535,
          "description": "SSH 端口，默认 22"
        },
        "user": {
          "type": "string",
          "description": "SSH 用户名"
        },
        "passwordEnv": {
          "type": "string",
          "description": "存放登录密码的环境变量名（密码本身不写进配置文件）"
        },
        "sudoPasswordEnv": {
          "type": "string",
          "description": "存放 sudo 密码的环境变量名，留空表示与登录密码相同"
        },
        "keyFile": {
          "type": "string",
          "description": "私钥路径（OpenSSH 格式），填了优先走公钥认证"
        },
        "keyPassphrase": {
          "type": "string",
          "description": "私钥口令"
        },
        "hostFingerprint": {
          "type": "string",
          "description": "主机密钥 SHA-256 指纹，填了启用严格模式校验"
        },
        "timeoutSec": {
          "type": "number",
          "minimum": 1,
          "description": "连接超时秒数，默认 15"
        },
        "execTimeoutSec": {
          "type": "number",
          "minimum": 1,
          "description": "单条远程命令超时秒数，默认 300"
        },
        "keepaliveIntervalSec": {
          "type": "number",
          "minimum": 0,
          "description": "keepalive 间隔秒数，0 关闭，默认 10"
        },
        "hosts": {
          "type": "object",
          "description": "多服务器映射表，key 为目标别名，value 覆盖同名字段",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
