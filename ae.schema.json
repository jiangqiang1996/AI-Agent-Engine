{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AE Skills 配置",
  "description": "AE 技能合集的配置文件。顶层 key 与技能同名，每个技能只读取自己的 key。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "ae-linux-remote-ops": {
      "type": "object",
      "description": "ae-linux-remote-ops 技能的 SSH 连接配置",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "服务器 IP 或域名"
        },
        "port": {
          "type": "number",
          "minimum": 1,
          "maximum": 65535,
          "description": "SSH 端口，默认 22"
        },
        "user": {
          "type": "string",
          "description": "SSH 用户名"
        },
        "passwordEnv": {
          "type": "string",
          "description": "存放登录密码的环境变量名（密码本身不写进配置文件）"
        },
        "sudoPasswordEnv": {
          "type": "string",
          "description": "存放 sudo 密码的环境变量名，留空表示与登录密码相同"
        },
        "keyFile": {
          "type": "string",
          "description": "私钥路径（OpenSSH 格式），填了优先走公钥认证"
        },
        "keyPassphrase": {
          "type": "string",
          "description": "私钥口令"
        },
        "hostFingerprint": {
          "type": "string",
          "description": "主机密钥 SHA-256 指纹，填了启用严格模式校验"
        },
        "timeoutSec": {
          "type": "number",
          "minimum": 1,
          "description": "连接超时秒数，默认 15"
        },
        "execTimeoutSec": {
          "type": "number",
          "minimum": 1,
          "description": "单条远程命令超时秒数，默认 300"
        },
        "keepaliveIntervalSec": {
          "type": "number",
          "minimum": 0,
          "description": "keepalive 间隔秒数，0 关闭，默认 10"
        },
        "hosts": {
          "type": "object",
          "description": "多服务器映射表，key 为目标别名，value 覆盖同名字段",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "ae-pptx": {
      "type": "object",
      "description": "ae-pptx 技能的配图配置。imageModel 用于文生图配图；未配置时只走 HTML → SVG 图表产线",
      "additionalProperties": false,
      "properties": {
        "imageModel": {
          "type": "object",
          "description": "文生图模型的「接入信息」。图片尺寸/质量/风格等生成参数不写在这里，由技能在调用时按版面需求提交（可写在提示词里）",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["openai", "gemini", "dashscope", "custom"],
              "description": "图片生成接口协议：openai=OpenAI 兼容网关，gemini=Gemini generateContent，dashscope=阿里云百炼，custom=自建/本地服务"
            },
            "baseUrl": {
              "type": "string",
              "description": "服务地址，不带结尾斜杠。留空按 provider 取默认值"
            },
            "path": {
              "type": "string",
              "description": "请求路径。留空按 provider 取默认值（openai 兼容默认 /images/generations）"
            },
            "model": {
              "type": "string",
              "description": "图片模型名，如 gpt-image-1、gemini-3-pro-image-preview、qwen-image"
            },
            "apiKey": {
              "type": "string",
              "description": "API Key 本体（优先级高于 apiKeyEnv）。仅适合本机私有配置，不要提交进版本库；脚本不会把它打印到日志"
            },
            "apiKeyEnv": {
              "type": "string",
              "description": "存放 API Key 的环境变量名（推荐方式）。留空按 provider 取默认值"
            },
            "timeoutSec": {
              "type": "number",
              "minimum": 1,
              "description": "调用超时秒数，默认 180"
            },
            "responsePath": {
              "type": "string",
              "description": "自定义响应取值路径，如 result.images.0。留空按常见键位自动识别"
            },
            "body": {
              "type": "object",
              "description": "追加到请求体的字段（只放网关特有字段，生成参数请用命令行传入）",
              "additionalProperties": true
            },
            "headers": {
              "type": "object",
              "description": "追加到请求头的字段",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "ae-qwen3-tts": {
      "type": "object",
      "description": "ae-qwen3-tts 技能的语音合成配置",
      "additionalProperties": false,
      "properties": {
        "modelRoot": {
          "type": "string",
          "description": "模型根目录，留空表示用技能目录下的 models/"
        },
        "outputDir": {
          "type": "string",
          "description": "默认输出目录，留空表示用 <cwd>/ae/qwen3-tts/"
        },
        "device": {
          "type": "string",
          "pattern": "^(auto|cpu|cuda(:[0-9]+)?)$",
          "description": "默认设备：auto / cuda / cuda:N / cpu"
        },
        "dtype": {
          "type": "string",
          "enum": ["auto", "bfloat16", "float16", "float32"],
          "description": "默认精度，auto=GPU 用 bf16、CPU 用 float32"
        },
        "attnImpl": {
          "type": "string",
          "enum": ["auto", "sdpa", "flash_attention_2", "eager", "flex_attention"],
          "description": "默认注意力实现"
        }
      }
    }
  }
}
