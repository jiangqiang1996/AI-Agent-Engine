{
  "name": "ai-agent-engine",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": ".opencode/plugins/ae-server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "postinstall": "node scripts/ensure-playwright.mjs",
    "postupdate": "node scripts/ensure-playwright.mjs",
    "sync-talk-normal": "node scripts/sync-talk-normal.mjs",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "^1.7.14",
    "@napi-rs/canvas": "^1.0.2",
    "@officecli/sdk": "^0.1.2",
    "@opencode-ai/plugin": "1.18.4",
    "@opencode-ai/sdk": "1.18.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/cli": "^0.1.17",
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.6.0",
    "effect": "4.0.0-beta.100",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "strip-json-comments": "^5.0.3",
    "turndown": "^7.2.4",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "26.1.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "zod": "^4.4.3",
    "effect": "4.0.0-beta.100"
  }
}
