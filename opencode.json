{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/**/*.md"
  ],
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow",
      "git commit *": "allow",
      "git push *": "ask",
      "rm -rf *": "deny",
      "del *": "deny"
    },
    "skill": {
      "*": "allow"
    }
  }
}