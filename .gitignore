**/node_modules
**/bun.lock
.idea
dist

# 临时目录
**/tmp
**/temp

# AE 本地配置（可能含本机专用的服务地址与密钥环境变量名，不入库）
/ae.jsonc

# AE 运行时产物（渲染图、生成配图、日志等，不入库）
/ae/

/playwright-report/
/test-results/

# 环境
/.env.local
.DS_Store

# 技能本地依赖（由技能首次使用时自行安装）
skills/*/node_modules/
skills/*/package-lock.json

# Python 技能的本地依赖与缓存
**/__pycache__/
*.py[cod]
skills/*/.venv/

# 语音合成技能的模型权重（GB 级，按需下载）
skills/*/models/
ae/*/models/
.agents