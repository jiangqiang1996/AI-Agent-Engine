{
  "openapi": "3.0.3",
  "info": { "title": "Pet Store", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/pets": {
      "get": {
        "tags": ["pets"],
        "operationId": "listPets",
        "summary": "列出宠物",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "返回数量" }
        ],
        "responses": {
          "200": {
            "description": "成功返回宠物列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "description": "宠物列表" }
                  },
                  "required": ["items"]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["pets"],
        "operationId": "createPet",
        "summary": "创建宠物",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "宠物名称" },
                  "age": { "type": "integer", "description": "宠物年龄" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "创建成功" },
          "400": { "description": "请求参数错误" }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "tags": ["pets"],
        "operationId": "getPet",
        "summary": "获取宠物详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "宠物 ID" }
        ],
        "responses": {
          "200": { "description": "成功返回宠物" },
          "404": { "description": "宠物不存在" }
        }
      }
    }
  }
}
