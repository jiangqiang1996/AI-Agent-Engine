{
  "openapi": "3.1.0",
  "info": { "title": "Pet Store 3.1", "version": "1.0.0" },
  "paths": {
    "/pets/{id}": {
      "get": {
        "summary": "获取宠物详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": ["string", "null"] } }
        ],
        "responses": {
          "200": {
            "description": "成功返回宠物",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "kind": { "const": "pet" },
                    "name": { "type": ["string", "null"], "examples": ["Fluffy"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
