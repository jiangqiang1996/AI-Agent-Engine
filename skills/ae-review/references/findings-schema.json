{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Findings",
  "description": "统一审查子代理的结构化输出 schema（全并行架构，代码域和文档域通用）",
  "type": "object",
  "required": ["reviewer", "findings", "residual_risks"],
  "properties": {
    "reviewer": {
      "type": "string",
      "description": "产生此输出的代理名称（例如 'ocr-reviewer'、'architecture-design-reviewer'）"
    },
    "findings": {
      "type": "array",
      "description": "审查发现列表。未发现问题时为空数组。",
      "items": {
        "type": "object",
        "required": [
          "title",
          "severity",
          "location",
          "why_it_matters",
          "finding_type",
          "confidence",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "简短、具体的问题标题，10个词以内。",
            "maxLength": 100
          },
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "问题严重程度级别"
          },
          "domain": {
            "type": "string",
            "enum": ["code", "document"],
            "description": "发现所属域（可选，用于区分代码域和文档域发现）"
          },
          "location": {
            "description": "发现位置，代码域为 file+line，文档域为 file+section",
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "file", "line"],
                "properties": {
                  "type": { "const": "code" },
                  "file": { "type": "string", "description": "相对于仓库根目录的文件路径" },
                  "line": { "type": "integer", "description": "问题的主要行号", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "required": ["type", "file", "section"],
                "properties": {
                  "type": { "const": "document" },
                  "file": { "type": "string", "description": "文档路径" },
                  "section": { "type": "string", "description": "文档中的章节标识" }
                }
              }
            ]
          },
          "why_it_matters": {
            "type": "string",
            "description": "影响和故障模式——不是'哪里错了'，而是'什么会出问题'"
          },
          "finding_type": {
            "type": "string",
            "enum": ["error", "omission", "pre-existing"],
            "description": "发现类型：error（有误之处）、omission（遗漏内容）、pre-existing（预存问题，与当前变更无关）"
          },
          "suggested_fix": {
            "type": ["string", "null"],
            "description": "建议的修复方向。代理只提供建议，实际修复由合并层统一处理。"
          },
          "confidence": {
            "type": "number",
            "description": "审查者对此发现的置信度",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "evidence": {
            "type": "array",
            "description": "基于实际代码/内容的证据。至少1项。",
            "items": { "type": "string" },
            "minItems": 1
          },
          "causes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "修复此问题会自动解决的 finding ID 列表。合并层据此构建因果依赖图。"
          },
          "caused_by": {
            "type": "array",
            "items": { "type": "string" },
            "description": "此问题被哪些问题自动解决的 finding ID 列表。合并层据此构建因果依赖图。"
          }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "description": "审查者注意到但无法确认为发现的风险",
      "items": { "type": "string" }
    },
    "testing_gaps": {
      "type": "array",
      "description": "审查者识别到的缺失测试覆盖",
      "items": { "type": "string" }
    }
  },
  "_meta": {
    "architecture": "full-parallel",
    "pipeline": {
      "steps": ["校验", "置信度门控", "合并去重+冲突解决+因果分析", "排序", "高风险零发现对抗"],
      "merge_layer": {
        "dedup": "指纹去重：normalize(file) + normalize(location.type) + normalize(location.line|section) + normalize(title)",
        "conflict_resolution": "同问题不同 severity 取最高；建议方向相反的发现保留双方并标记 conflict",
        "causal_analysis": "遍历 causes/caused_by 构建依赖图，识别根因发现，标记 auto_resolved"
      }
    },
    "confidence_thresholds": {
      "code": {
        "suppress": "低于 0.60——不报告。例外：0.50+ 的 P0。",
        "flag": "0.60-0.69——仅在明确可操作时包含。",
        "confident": "0.70-0.84——附完整证据报告。",
        "certain": "0.85-1.00——仅从代码验证。"
      },
      "document": {
        "suppress": "低于 0.50——不报告。例外：0.50+ 的 P0。",
        "flag": "0.50-0.59——标记为残余风险。",
        "confident": "0.60-0.84——附完整证据报告。",
        "certain": "0.85-1.00——确定，报告。"
      }
    },
    "causal_fields": {
      "causes": "修复此问题会自动解决的 finding ID 列表",
      "caused_by": "此问题被哪些问题自动解决的 finding ID 列表",
      "auto_resolved_by": "合并层标记：被哪个根因发现自动解决",
      "circular_dependency": "合并层标记：因果图中检测到环依赖"
    },
    "agent_principle": "代理只找问题不做修复，修复由合并层和修复流程统一处理",
    "return_tiers": {
      "merge_tier": "返回给编排器：title、severity、domain（可选）、location、finding_type、confidence、evidence、causes、caused_by、suggested_fix。",
      "detail_tier": "产物文件中必填：why_it_matters、evidence。"
    }
  }
}
